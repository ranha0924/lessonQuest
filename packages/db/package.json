{
  "name": "@lessonquest/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "node": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "default": null
    },
    "./provisioning": {
      "node": {
        "types": "./dist/provisioning.d.ts",
        "default": "./dist/provisioning.js"
      },
      "default": null
    },
    "./runtime-readiness": {
      "node": {
        "types": "./dist/runtime-readiness.d.ts",
        "default": "./dist/runtime-readiness.js"
      },
      "default": null
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@lessonquest/contracts": "workspace:*",
    "@lessonquest/gamification": "workspace:*",
    "@lessonquest/rasa": "workspace:*",
    "@lessonquest/science-studio": "workspace:*",
    "pg": "catalog:"
  }
}
